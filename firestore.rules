rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{adminUid} {
      // A user can check their own admin status; only existing admins can manage roles.
      allow get: if signedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /liveGames/{sessionId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
  }
}
