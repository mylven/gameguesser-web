rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{adminUid} {
      // A user can check their own admin status; only existing admins can manage roles.
      allow get: if signedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /liveGames/{sessionId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /siteVisitors/{visitorId} {
      // Anonymous, pseudonymous browser counters only: never store IPs or profile data.
      allow create: if visitorId.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['visitCount', 'lastSeenAt'])
        && request.resource.data.keys().hasAll(['visitCount', 'lastSeenAt'])
        && request.resource.data.visitCount is int
        && request.resource.data.visitCount == 1
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.lastSeenAt == request.time;
      allow update: if visitorId.matches('^[a-f0-9]{32}$')
        && resource.data.keys().hasOnly(['visitCount', 'lastSeenAt'])
        && request.resource.data.keys().hasOnly(['visitCount', 'lastSeenAt'])
        && request.resource.data.keys().hasAll(['visitCount', 'lastSeenAt'])
        && resource.data.visitCount is int
        && request.resource.data.visitCount is int
        && request.resource.data.visitCount == resource.data.visitCount + 1
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitCount', 'lastSeenAt']);
      allow read, delete: if isAdmin();
    }

    match /leaderboard/{playerUid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == playerUid
        && request.resource.data.keys().hasOnly(['displayName', 'totalScore', 'gamesPlayed', 'updatedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'totalScore', 'gamesPlayed', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0
        && request.resource.data.gamesPlayed is int
        && request.resource.data.gamesPlayed >= 0
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /duelLeaderboard/{playerUid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == playerUid
        && request.resource.data.keys().hasOnly(['displayName', 'wins', 'matches', 'totalScore', 'updatedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'wins', 'matches', 'totalScore', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.wins is int
        && request.resource.data.wins >= 0
        && request.resource.data.matches is int
        && request.resource.data.matches >= 0
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /premiumEntitlements/{playerUid} {
      allow get: if signedIn() && (request.auth.uid == playerUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /premiumRequests/{playerUid} {
      allow get: if signedIn() && (request.auth.uid == playerUid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == playerUid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'requestedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'email', 'requestedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.requestedAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
